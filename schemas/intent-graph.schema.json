{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecode.local/schemas/intent-graph.schema.json",
  "title": "OneCode Intent Graph",
  "type": "object",
  "required": ["intents", "unresolved_dependencies"],
  "properties": {
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "task_type",
          "required_artifacts",
          "risk_flags",
          "depends_on",
          "source",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^i[1-9][0-9]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "task_type": {
            "type": "string",
            "minLength": 1
          },
          "required_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^i[1-9][0-9]*$"
            }
          },
          "source": {
            "type": "string",
            "enum": ["deterministic", "semantic", "hybrid"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
