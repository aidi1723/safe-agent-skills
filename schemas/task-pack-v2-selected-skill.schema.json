{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecode.local/schemas/task-pack-v2-selected-skill.schema.json",
  "title": "OneCode Task Pack v2 Selected Skill",
  "type": "object",
  "required": [
    "name",
    "status",
    "risk_level",
    "match_score",
    "taxonomy",
    "source",
    "hashes",
    "registry_path",
    "description",
    "when_to_use",
    "safe_workflow",
    "expected_output",
    "verifier_expectations",
    "failure_handling",
    "policy"
  ],
  "properties": {
    "name": {"$ref": "#/$defs/skill_name"},
    "status": {"const": "trusted"},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "match_score": {"type": "integer", "minimum": 0},
    "taxonomy": {"$ref": "#/$defs/taxonomy"},
    "source": {"$ref": "#/$defs/source"},
    "hashes": {"$ref": "#/$defs/hashes"},
    "registry_path": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*/[a-z0-9][a-z0-9_-]{1,80}$"
    },
    "description": {"type": "string"},
    "when_to_use": {"type": "string"},
    "safe_workflow": {"type": "string"},
    "expected_output": {"type": "string"},
    "verifier_expectations": {"type": "string"},
    "failure_handling": {"type": "string"},
    "policy": {"$ref": "#/$defs/policy"},
    "contract": {
      "oneOf": [
        {"$ref": "https://onecode.dev/schemas/contract-v2.schema.json"},
        {"$ref": "#/$defs/legacy_contract"}
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
    },
    "taxonomy": {
      "type": "object",
      "required": ["category", "subcategory", "collection_priority"],
      "properties": {
        "category": {
          "enum": [
            "design",
            "code",
            "engineering",
            "security",
            "office",
            "execution",
            "research",
            "data",
            "business",
            "content",
            "commerce",
            "media",
            "compliance",
            "ai",
            "vertical"
          ]
        },
        "subcategory": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)?$"
        },
        "task_intent": {"type": "string"},
        "artifact_type": {"type": "string"},
        "collection_priority": {"enum": ["P0", "P1", "P2", "P3"]}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "usage",
        "path",
        "url",
        "author",
        "license",
        "reference",
        "collected_by",
        "captured_at"
      ],
      "properties": {
        "type": {
          "enum": [
            "local_folder",
            "archive",
            "git",
            "community_index",
            "github_reference",
            "web_reference"
          ]
        },
        "usage": {"enum": ["source_import", "reference_only", "local_authoring"]},
        "path": {"type": "string"},
        "url": {"type": "string"},
        "author": {"type": "string"},
        "license": {"type": "string"},
        "reference": {"type": "string"},
        "collected_by": {"type": "string"},
        "captured_at": {"type": "string", "minLength": 1},
        "commit": {"type": "string"}
      },
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "required": ["source_sha256", "sanitized_sha256", "manifest_sha256"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "sanitized_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "legacy_contract": {
      "type": "object",
      "required": ["requires_context", "capability_vector", "stage_hint", "cost_weight"],
      "properties": {
        "requires_context": {"$ref": "#/$defs/contract_artifacts"},
        "produces_artifacts": {"$ref": "#/$defs/contract_artifacts"},
        "produces_evidence": {"$ref": "#/$defs/contract_artifacts"},
        "capability_vector": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        },
        "stage_hint": {"enum": ["planning", "review"]},
        "cost_weight": {"type": "integer", "minimum": 1, "maximum": 10}
      },
      "oneOf": [
        {"required": ["produces_artifacts"]},
        {"required": ["produces_evidence"]}
      ],
      "additionalProperties": false
    },
    "contract_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,80}$"}
    },
    "policy": {
      "type": "object",
      "required": ["filesystem", "network", "approval"],
      "properties": {
        "filesystem": {
          "type": "object",
          "required": ["scope"],
          "properties": {
            "scope": {"enum": ["workspace_only", "read_only_workspace", "none"]}
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": ["scope"],
          "properties": {
            "scope": {"enum": ["none", "approved_hosts", "onecode_api_only"]},
            "approved_hosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "required": ["required_for"],
          "properties": {
            "required_for": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
