{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecode.local/schemas/task-pack-v2.schema.json",
  "title": "OneCode Task Pack v2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "route_id",
    "routing_mode",
    "routing_status",
    "provider",
    "normalized_task",
    "intent_graph",
    "scenario_candidates",
    "selected_scenarios",
    "uncovered_intents",
    "selected_skills",
    "capability_resolution",
    "execution_graph",
    "host_execution_protocol",
    "routing_metrics",
    "registry_verification",
    "compatibility"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "generated_at": {"type": "string", "minLength": 1},
    "route_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "routing_mode": {"const": "hybrid"},
    "routing_status": {"enum": ["blocked", "incomplete", "complete"]},
    "provider": {"$ref": "#/$defs/provider"},
    "normalized_task": {"$ref": "#/$defs/normalized_task"},
    "intent_graph": {
      "allOf": [
        {"$ref": "intent-graph.schema.json"},
        {"$ref": "#/$defs/intent_graph_id_safety"}
      ]
    },
    "scenario_candidates": {
      "type": "array",
      "maxItems": 36,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenario_candidate"}
    },
    "selected_scenarios": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/selected_scenario"}
    },
    "uncovered_intents": {"$ref": "#/$defs/intent_ids"},
    "selected_skills": {
      "$comment": "uniqueItems rejects identical records; JSON Schema cannot enforce uniqueness by Skill name.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "task-pack-v2-selected-skill.schema.json"}
    },
    "capability_resolution": {"$ref": "#/$defs/capability_resolution"},
    "execution_graph": {"$ref": "#/$defs/execution_graph"},
    "host_execution_protocol": {"$ref": "#/$defs/host_execution_protocol"},
    "routing_metrics": {"$ref": "#/$defs/routing_metrics"},
    "registry_verification": {"$ref": "#/$defs/registry_verification"},
    "compatibility": {"$ref": "#/$defs/compatibility"}
  },
  "allOf": [
    {
      "if": {"properties": {"routing_status": {"const": "complete"}}},
      "then": {
        "properties": {
          "uncovered_intents": {"maxItems": 0},
          "selected_scenarios": {"minItems": 1},
          "selected_skills": {"minItems": 1},
          "capability_resolution": {
            "properties": {
              "status": {"const": "complete"},
              "missing_required_count": {"const": 0}
            }
          },
          "execution_graph": {"properties": {"status": {"const": "ready"}}},
          "routing_metrics": {
            "properties": {
              "decomposition": {
                "properties": {
                  "candidate_signal_limit_exceeded": {"const": false},
                  "intent_limit_exceeded": {"const": false},
                  "reason_codes": {"maxItems": 0}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"routing_status": {"const": "incomplete"}}},
      "then": {
        "anyOf": [
          {"properties": {"uncovered_intents": {"minItems": 1}}},
          {
            "properties": {
              "capability_resolution": {
                "properties": {"status": {"const": "incomplete"}}
              }
            }
          },
          {
            "properties": {
              "routing_metrics": {
                "properties": {
                  "decomposition": {"properties": {"reason_codes": {"minItems": 1}}}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {"properties": {"routing_status": {"const": "blocked"}}},
      "then": {
        "properties": {
          "execution_graph": {
            "properties": {
              "status": {"const": "blocked"},
              "reason_codes": {"contains": {"$ref": "#/$defs/fatal_execution_reason_code"}}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "intent_id": {
      "type": "string",
      "pattern": "^i[1-9][0-9]*(?![\\s\\S])"
    },
    "intent_ids": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/intent_id"}
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
    },
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,80}(?![\\s\\S])"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_-]*(?![\\s\\S])"
    },
    "stage": {
      "enum": ["preflight", "source", "planning", "production", "review", "execution", "verification", "handoff"]
    },
    "provider": {
      "type": "object",
      "required": ["requested", "used", "fallback_reason"],
      "properties": {
        "requested": {"const": "none"},
        "used": {"const": "none"},
        "fallback_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "normalized_task": {
      "type": "object",
      "required": ["raw", "current", "history", "stale", "stale_policy"],
      "properties": {
        "raw": {"type": "string"},
        "current": {"type": "string"},
        "history": {"type": "string"},
        "stale": {"type": "string"},
        "stale_policy": {"type": "string"}
      },
      "additionalProperties": false
    },
    "intent_graph_id_safety": {
      "type": "object",
      "properties": {
        "intents": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "id": {"$ref": "#/$defs/intent_id"},
              "depends_on": {"$ref": "#/$defs/intent_ids"}
            }
          }
        }
      }
    },
    "scenario_candidate": {
      "type": "object",
      "required": ["intent_id", "scenario_id", "score", "deterministic_score"],
      "properties": {
        "intent_id": {"$ref": "#/$defs/intent_id"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "deterministic_score": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "selected_scenario": {
      "type": "object",
      "required": ["scenario_id", "intent_ids", "score", "score_breakdown"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "intent_ids": {
          "allOf": [{"$ref": "#/$defs/intent_ids"}, {"minItems": 1}]
        },
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "score_breakdown": {"$ref": "#/$defs/score_breakdown"}
      },
      "additionalProperties": false
    },
    "score_breakdown": {
      "type": "object",
      "required": ["deterministic_signal", "deterministic_score"],
      "properties": {
        "deterministic_signal": {"type": "number", "minimum": 0, "maximum": 1},
        "deterministic_score": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "capability_resolution": {
      "$comment": "missing_required_count is unbounded because caller-supplied bundles can declare arbitrary capabilities; JSON Schema cannot equate it to matching array entries.",
      "type": "object",
      "required": ["status", "capabilities", "missing_required_count"],
      "properties": {
        "status": {"enum": ["complete", "incomplete"]},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"}
        },
        "missing_required_count": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}},
          "then": {
            "properties": {
              "missing_required_count": {"const": 0},
              "capabilities": {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "required": {"const": true},
                      "status": {"const": "missing"}
                    },
                    "required": ["required", "status"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "incomplete"}}},
          "then": {
            "properties": {
              "missing_required_count": {"minimum": 1},
              "capabilities": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "required": {"const": true},
                    "status": {"const": "missing"}
                  },
                  "required": ["required", "status"]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["scenario_id", "capability", "required", "status", "skills"],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^(?:[a-z0-9][a-z0-9-]*)?(?![\\s\\S])"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
        },
        "required": {"type": "boolean"},
        "status": {"enum": ["covered", "missing"]},
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skill_name"}
        },
        "source": {"const": "invariant"},
        "stage": {
          "anyOf": [{"$ref": "#/$defs/stage"}, {"const": ""}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "covered"}}},
          "then": {"properties": {"skills": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "missing"}}},
          "then": {"properties": {"skills": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    },
    "execution_graph": {
      "type": "object",
      "required": ["schema_version", "status", "acyclic", "nodes", "edges", "reason_codes"],
      "properties": {
        "schema_version": {"type": "integer", "const": 2},
        "status": {"enum": ["ready", "blocked"]},
        "acyclic": {"type": "boolean"},
        "nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/execution_node"}
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/execution_edge"}
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/execution_reason_code"}
        },
        "details": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ready"}}},
          "then": {
            "properties": {
              "acyclic": {"const": true},
              "nodes": {"minItems": 1},
              "reason_codes": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "blocked"}}},
          "then": {
            "properties": {
              "acyclic": {"const": false},
              "reason_codes": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "execution_node": {
      "type": "object",
      "required": ["id", "intent_ids", "scenario_ids", "skill", "stage", "host_action"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "intent_ids": {"$ref": "#/$defs/intent_ids"},
        "scenario_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scenario_id"}
        },
        "skill": {"$ref": "#/$defs/skill_name"},
        "stage": {"$ref": "#/$defs/stage"},
        "host_action": {"type": "boolean"},
        "invariant_capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "execution_edge": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": {"$ref": "#/$defs/node_id"},
        "to": {"$ref": "#/$defs/node_id"},
        "type": {
          "enum": [
            "scenario_order",
            "intent_verification_dependency",
            "intent_completion_dependency",
            "invariant_safeguard"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution_reason_code": {
      "enum": [
        "dependency_cycle",
        "invalid_stage_map",
        "missing_scenario_bundle",
        "malformed_execution_order",
        "empty_execution_order",
        "duplicate_skill_name",
        "untrusted_scenario",
        "duplicate_intent_selection",
        "incomplete_composition",
        "missing_intent_verification",
        "invalid_intent_graph",
        "malformed_intent_graph",
        "duplicate_intent_id",
        "malformed_intent_dependency",
        "unknown_intent_dependency",
        "malformed_composition",
        "malformed_scenario_id",
        "malformed_selection_intents",
        "unknown_intent_id",
        "malformed_bundles_index",
        "missing_trusted_skill_pack_item"
      ]
    },
    "fatal_execution_reason_code": {
      "enum": [
        "dependency_cycle",
        "invalid_stage_map",
        "missing_scenario_bundle",
        "malformed_execution_order",
        "empty_execution_order",
        "duplicate_skill_name",
        "untrusted_scenario",
        "duplicate_intent_selection",
        "missing_intent_verification",
        "invalid_intent_graph",
        "malformed_intent_graph",
        "duplicate_intent_id",
        "malformed_intent_dependency",
        "unknown_intent_dependency",
        "malformed_composition",
        "malformed_scenario_id",
        "malformed_selection_intents",
        "unknown_intent_id",
        "malformed_bundles_index",
        "missing_trusted_skill_pack_item"
      ]
    },
    "host_execution_protocol": {
      "type": "object",
      "required": ["mode", "runtime_boundary", "node_statuses"],
      "properties": {
        "mode": {"const": "method_only"},
        "runtime_boundary": {"const": "The host runtime controls permissions and execution."},
        "node_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["pending", "ready", "running", "waiting_approval", "completed", "failed", "blocked", "skipped"]
          }
        }
      },
      "additionalProperties": false
    },
    "routing_metrics": {
      "$comment": "Hard producer limits are bounded below. Skill counts remain unbounded because registries and bundle execution orders are caller supplied; JSON Schema cannot equate counts to array lengths.",
      "type": "object",
      "required": [
        "intent_count",
        "candidate_count",
        "selected_scenario_count",
        "required_skill_count",
        "selected_skill_count",
        "optional_skill_limit",
        "optional_skills_selected",
        "required_skills_omitted",
        "overlap_policy",
        "decomposition"
      ],
      "properties": {
        "intent_count": {"type": "integer", "minimum": 1, "maximum": 12},
        "candidate_count": {"type": "integer", "minimum": 0, "maximum": 36},
        "selected_scenario_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "required_skill_count": {"type": "integer", "minimum": 0},
        "selected_skill_count": {"type": "integer", "minimum": 0},
        "optional_skill_limit": {
          "$comment": "User-controlled and intentionally unbounded; JSON Schema cannot tie it to array lengths.",
          "type": "integer",
          "minimum": 0
        },
        "optional_skills_selected": {"type": "integer", "const": 0},
        "required_skills_omitted": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skill_name"}
        },
        "overlap_policy": {"enum": ["not_configured", "validated_not_applied"]},
        "decomposition": {"$ref": "#/$defs/decomposition_diagnostics"}
      },
      "additionalProperties": false
    },
    "decomposition_diagnostics": {
      "type": "object",
      "required": [
        "mode",
        "observed_candidate_count",
        "emitted_intent_count",
        "candidate_signal_limit_exceeded",
        "intent_limit_exceeded",
        "reason_codes"
      ],
      "properties": {
        "mode": {"enum": ["single_clause", "strong_clauses", "profile_spans"]},
        "observed_candidate_count": {"type": "integer", "minimum": 0, "maximum": 129},
        "emitted_intent_count": {"type": "integer", "minimum": 1, "maximum": 12},
        "candidate_signal_limit_exceeded": {"type": "boolean"},
        "intent_limit_exceeded": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "task_scan_limit_exceeded",
              "candidate_signal_limit_exceeded",
              "intent_limit_exceeded",
              "ambiguous_profile_enumeration"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"candidate_signal_limit_exceeded": {"const": true}}
          },
          "then": {
            "properties": {
              "reason_codes": {"contains": {"const": "candidate_signal_limit_exceeded"}}
            }
          },
          "else": {
            "properties": {
              "reason_codes": {
                "not": {"contains": {"const": "candidate_signal_limit_exceeded"}}
              }
            }
          }
        },
        {
          "if": {"properties": {"intent_limit_exceeded": {"const": true}}},
          "then": {
            "properties": {
              "reason_codes": {"contains": {"const": "intent_limit_exceeded"}}
            }
          },
          "else": {
            "properties": {
              "reason_codes": {"not": {"contains": {"const": "intent_limit_exceeded"}}}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "registry_verification": {
      "$comment": "Registry counts are unbounded because caller-supplied registries have no schema-level size limit.",
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "status",
        "skill_count",
        "trusted_count",
        "tampered_count",
        "unknown_provenance_count",
        "issues"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "status": {"enum": ["ok", "failed"]},
        "skill_count": {"type": "integer", "minimum": 0},
        "trusted_count": {"type": "integer", "minimum": 0},
        "tampered_count": {"type": "integer", "minimum": 0},
        "unknown_provenance_count": {"type": "integer", "minimum": 0},
        "issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/registry_issue"}
        }
      },
      "additionalProperties": false
    },
    "registry_issue": {
      "type": "object",
      "required": ["id", "severity", "skill", "path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "skill": {"$ref": "#/$defs/skill_name"},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["legacy_schema_version", "compatibility_loss"],
      "properties": {
        "legacy_schema_version": {"type": "integer", "const": 1},
        "compatibility_loss": {"$ref": "#/$defs/compatibility_loss"}
      },
      "additionalProperties": false
    },
    "compatibility_loss": {
      "$comment": "Dropped edge counts are unbounded because caller-supplied execution orders have no schema-level size limit.",
      "type": "object",
      "required": ["multi_intent_dropped", "scenarios_dropped", "cross_scenario_edges_dropped"],
      "properties": {
        "multi_intent_dropped": {"type": "boolean"},
        "scenarios_dropped": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scenario_id"}
        },
        "cross_scenario_edges_dropped": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
