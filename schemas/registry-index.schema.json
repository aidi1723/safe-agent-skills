{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecode.local/schemas/registry-index.schema.json",
  "title": "OneCode Skill Registry Index",
  "type": "object",
  "required": ["schema_version", "generated_at", "skill_count", "skills"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "skill_count": {
      "type": "integer",
      "minimum": 0
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "risk_level",
          "taxonomy",
          "source",
          "hashes",
          "registry_path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["quarantined", "review_required", "trusted", "rejected", "disabled"]
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "taxonomy": {
            "type": "object"
          },
          "source": {
            "type": "object",
            "required": [
              "type",
              "usage",
              "path",
              "url",
              "author",
              "license",
              "reference",
              "collected_by",
              "captured_at"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "local_folder",
                  "archive",
                  "git",
                  "community_index",
                  "github_reference",
                  "web_reference"
                ]
              },
              "usage": {
                "type": "string",
                "enum": [
                  "source_import",
                  "reference_only",
                  "local_authoring"
                ]
              },
              "url": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "collected_by": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "captured_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "hashes": {
            "type": "object"
          },
          "registry_path": {
            "type": "string"
          },
          "match_score": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
